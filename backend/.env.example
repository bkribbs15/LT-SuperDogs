# LT SuperDogs Backend Configuration
# Copy this file to .env and fill in your actual values

# Database — SQLite. Local (non-Docker) runs default to backend/local_dev.db.
# The container sets SQLITE_DB_PATH=/data/superdogs.db (mounted volume) via
# docker-compose. Don't add SQLITE_DB_PATH here — it's read from the OS env.

# JWT Settings
# Generate a secure random key using: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-this-to-something-random-and-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ESPN college football scoreboard (public, no key). CFB_GROUP=80 is FBS.
CFB_API_URL=https://site.api.espn.com/apis/site/v2/sports/football/college-football/scoreboard
CFB_GROUP=80
SYNC_INTERVAL_MINUTES=10
# First week that counts. Earlier weeks never appear on the board.
SEASON_FIRST_WEEK=2

# Email (optional). Leave SMTP_HOST empty to disable reminders/result emails.
# Gmail: smtp.gmail.com:587 with an App Password. Fastmail/SendGrid/Postmark
# SMTP all work the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LT SuperDogs <you@example.com>
REMINDER_HOURS=24,3
DISPLAY_TIMEZONE=America/Chicago

# CORS Settings
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:8101

# Admin / Owner Settings
# ADMIN_EMAIL should match the owner account so the user created on first
# startup IS the owner. Change the password immediately.
ADMIN_EMAIL=admin@superdogs.local
ADMIN_PASSWORD=ChangeThisPassword123!
OWNER_EMAIL=bkribbs15@gmail.com

# App Settings
APP_NAME=LT SuperDogs API
VERSION=1.0.0
DEBUG=False
